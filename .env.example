# ===== WhisperMark 2.0 配置示例 =====
# 复制为 .env 后填写（.env 会被自动加载，且不覆盖已存在的系统环境变量）

# ---- AI（OpenAI 兼容接口）----
# 必填：AI API Key（不填也能用 `python main.py demo` 虚拟体验）
WM_AI_API_KEY=sk-xxx
# 可选：接口地址与模型（默认 DeepSeek）
WM_AI_BASE_URL=https://api.deepseek.com/v1
WM_AI_MODEL=deepseek-chat
# 可选：输出 token 上限
# WM_AI_MAX_TOKENS_ANALYZE=2048
# WM_AI_MAX_TOKENS_GRADE=1024

# ---- 浏览器 ----
# WM_HEADLESS=false
# WM_STEALTH=true
# WM_SLOW_MO=100

# ---- 监控服务器 ----
# WM_MONITOR_ENABLED=true
# WM_MONITOR_PORT=8321
# WM_MONITOR_HOST=127.0.0.1
# 端口被占用时自动顺延（false 则直接报错）
# WM_MONITOR_PORT_FALLBACK=true

# ---- 数据目录（可选，默认项目下的 data/ 与 runtime/）----
# WM_DATA_DIR=D:/whispermark-data
# WM_RUNTIME_DIR=D:/whispermark-runtime

# ---- 微信推送（可选，workbuddy 小龙虾 / Server酱 等 webhook）----
WM_WECHAT_ENABLED=false
WM_WECHAT_WEBHOOK_URL=https://your-webhook-url
# 每 N 份推一次进度
WM_WECHAT_PROGRESS_INTERVAL=50
# webhook JSON 的字段名（Server酱 用 content）
# WM_WECHAT_PAYLOAD_KEY=text

# ---- 阅卷 ----
# 兜底满分（优先从页面读取）
# WM_MAX_SCORE=13
# WM_RETRY_DELAY=1.0
# 连续 N 次拿不到答题卡判定完成
# WM_MAX_EMPTY_RETRIES=5
